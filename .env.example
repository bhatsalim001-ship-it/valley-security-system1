# ==============================================================================
# VALLEY SECURITY SYSTEM (VSA) — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and supply your secret credentials before launching.
# ==============================================================================

# 1. Neon PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://user:password@ep-shiny-king-aosr4w3y-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. Cryptographic JWT Secret for Admin Session Tokens & QR Verification
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-secure-64-character-cryptographic-hex-secret"

# 3. Application Runtime Port (Render defaults to 10000 or 3000)
PORT=3000

# 4. Environment Mode (development | production)
NODE_ENV=production

# 5. Google Gemini AI API Configuration (for OCR & Smart Intake)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-3.8-flash"

# 6. Administrative Emergency Kill-Switch Key (Optional)
KILL_SWITCH_KEY="replace-with-emergency-maintenance-key"
